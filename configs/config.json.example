{
  "interval": "30s",
  "audit_interval": "1h",
  "state_path": "/var/lib/banhack233/state.json",
  "dry_run": true,
  "start_at_end": true,
  "ignore_ips": ["127.0.0.1", "::1"],
  "rules": [
    {
      "name": "ssh-auth-failure",
      "log_paths": ["/var/log/auth.log", "/var/log/secure"],
      "patterns": [
        "Failed password.*from (?P<ip>\\d+\\.\\d+\\.\\d+\\.\\d+)",
        "Invalid user .* from (?P<ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
      ],
      "max_attempts": 5,
      "find_time": "10m",
      "ban_time": "1h",
      "action": "auto"
    }
  ],
  "hardening": {
    "ssh": {
      "enabled": true,
      "password_authentication": true,
      "permit_root_login": "yes",
      "allowed_users": [],
      "max_auth_tries": 3,
      "login_grace_time": "20s",
      "client_alive_interval": 300,
      "client_alive_count_max": 2,
      "disable_empty_passwords": true,
      "disable_challenge_response": true
    }
  },
  "geoip": {
    "enabled": true,
    "db_path": "/var/lib/banhack233/ip2region_v4.xdb"
  },
  "malware": {
    "enabled": true,
    "direct_kill": false,
    "report_dir": "/var/lib/banhack233/reports",
    "report_keep": 50
  },
  "notifications": {
    "console": true,
    "audit": false,
    "batch": {
      "enabled": true,
      "interval": "60s",
      "max_items": 20
    },
    "feishu": {
      "enabled": false,
      "url": "https://open.feishu.cn/open-apis/bot/v2/hook/xxx",
      "secret": "your-feishu-sign-secret"
    },
    "discord": {
      "enabled": false,
      "url": "https://discord.com/api/webhooks/xxx/yyy"
    },
    "slack": {
      "enabled": false,
      "url": "https://hooks.slack.com/services/xxx/yyy/zzz"
    },
    "webhooks": [
      {
        "name": "custom-json",
        "enabled": false,
        "url": "https://example.com/webhook",
        "format": "json",
        "headers": {
          "Authorization": "Bearer token"
        }
      }
    ],
    "email": {
      "enabled": false,
      "from": "alert@qq.com",
      "to": "admin@example.com",
      "password": "smtp-authorization-code",
      "smtp_host": "",
      "smtp_port": 0
    }
  }
}
